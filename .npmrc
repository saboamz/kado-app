# @vercel/analytics declares optional peers for every framework it supports —
# SvelteKit, Nuxt, Vue — and npm tries to resolve them even on a Next project
# that will never load them. The chain reaches a Svelte plugin wanting Vite 8
# while Vitest holds Vite 5, and the install fails on a package neither the
# app nor its tests will ever import.
#
# Here rather than in a command, so `npm ci` in CI and on Vercel behaves the
# same way a local install does.
legacy-peer-deps=true
