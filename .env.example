# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://kado:kado@localhost:5432/kado?schema=public"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-secret-change-me-in-production-0000000000000000"

# The direct (non-pooled) connection, used by migrations only.
#
# PgBouncer in transaction mode cannot carry the session state that DDL and
# advisory locks need, so `prisma migrate deploy` must bypass the pooler.
# Locally there is no pooler, so this is the same URL as above; on Neon it is
# the host WITHOUT `-pooler`.
DIRECT_URL="postgresql://kado:kado@localhost:5432/kado?schema=public"

# ── Production only ────────────────────────────────────────────────────────
#
# Vercel Blob. Its presence is what switches image storage from the local disk
# to Blob — required on Vercel, where the function filesystem is ephemeral and
# unshared, so a file written by one request is gone on the next.
# Created by: vercel blob store add
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Bearer token Vercel Cron sends to /api/cron. Without it the endpoint refuses
# to run at all rather than running unprotected — the two jobs behind it are
# heavy database writes and an open endpoint is a denial of service.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=""

# Recherche de GIFs pour la décoration des profils (facultatif).
#
# Sans cette clé, la fonctionnalité reste visible mais explique qu'elle n'est
# pas configurée — elle ne casse rien. La clé ne quitte jamais le serveur :
# la recherche passe par une server action, parce qu'une clé envoyée au
# navigateur est une clé publique.
#
# Gratuite sur developers.giphy.com (créer une app « API », pas « SDK »).
# GIPHY_API_KEY=""
