generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  /// The pooled connection, used by the running app. On Neon this is the
  /// `-pooler` host; every serverless instance goes through PgBouncer rather
  /// than opening its own connection to Postgres.
  url        = env("DATABASE_URL")
  /// The direct connection, used by migrations only.
  ///
  /// DDL and advisory locks need session state that PgBouncer in transaction
  /// mode does not carry, so `prisma migrate deploy` must bypass the pooler.
  /// Required: Prisma has no implicit fallback. Locally and in CI it is set to
  /// the same URL as above, since a local Postgres has no pooler in front.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  bio           String?
  /// Answers to the sign-up questionnaire. Both optional, and NULL is the
  /// answer "I would rather not say" — a refusal is not a category, so it is
  /// not one here either.
  ///
  /// Ordinary personal data under the GDPR, not a special category: no
  /// religion, health, ethnicity or orientation is asked for anywhere. They
  /// exist to feed recommendations and are never shown on a profile.
  gender        Gender?
  ageBracket    AgeBracket?
  /// An uploaded photo. Absent, the avatar falls back to the person's
  /// initials on a tint derived from their name — see avatarTint() in
  /// format.ts. There is no stored colour: it was removed once nothing
  /// rendered it.
  avatarUrl     String?
  theme         Theme     @default(SYSTEM)
  /// Which language this person reads the app in.
  ///
  /// A preference rather than a URL prefix: theme and currency already work
  /// this way, and a /fr /en split would move every route and break links
  /// already shared — invitations included.
  locale        String    @default("fr")
  profilePublic Boolean   @default(false)
  /// When the getting-started checklist was dismissed.
  ///
  /// The only part of it that cannot be derived: whether each step is DONE is
  /// a question the data already answers, but "I have seen this and do not
  /// want it any more" is a decision, and nothing else records it.
  onboardingDismissedAt DateTime?
  currency      String    @default("EUR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  passwordResets   PasswordReset[]
  lists            GiftList[]
  interests        Interest[]
  reservations     Reservation[]
  purchases        Reservation[]     @relation("PotBuyer")
  reportsMade      Report[]          @relation("Reporter")
  reportsAbout     Report[]          @relation("Reported")
  contributions    PotContribution[]
  sentRequests     Friendship[]      @relation("Requester")
  receivedRequests Friendship[]      @relation("Addressee")
  notifications    Notification[]
  messages         ChatMessage[]
  invites          Invite[]
  decorations      ProfileDecoration[]
  events           LifeEvent[]

  // No @@index([email]): `email @unique` above already creates a B-tree, so a
  // second index on the same column only cost writes and storage.
}

/// How somebody describes themselves, when they choose to.
enum Gender {
  FEMALE
  MALE
  OTHER
}

/// An age range rather than a date of birth.
///
/// A birthday identifies a person; a decade does not, and the recommender
/// cannot tell the difference. Starts at 15 because the terms require it.
enum AgeBracket {
  AGE_15_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_64
  AGE_65_PLUS
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One outstanding "choose a new password" link.
///
/// Same shape as Session, for the same reason: the id is the SHA-256 of the
/// token the e-mail carries, so the row is useless to anyone who reads the
/// database — see the comment on createSession() in src/lib/session.ts.
///
/// At most one lives per account: issuing a new link deletes the previous
/// ones, because two valid links means the older e-mail — sitting in an
/// inbox somebody may no longer control — still opens the account.
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set atomically when the token is spent. A used token is kept until the
  /// nightly purge rather than deleted, so a replayed link fails the same
  /// way an expired one does instead of looking like it never existed.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Interest {
  id     String @id @default(cuid())
  label  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
}

model GiftList {
  id         String     @id @default(cuid())
  name       String
  occasion   String?
  visibility Visibility @default(FRIENDS)
  isDefault  Boolean    @default(false)
  allowPots  Boolean    @default(true)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  gifts Gift[]

  @@index([ownerId])
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

/// A date somebody chooses to publish about themselves.
///
/// This replaced a single `birthday` column on User. That column decided for
/// everybody which date mattered and what it was called, and it was the only
/// one on offer: a person with a wedding, a graduation or nothing at all had
/// no way to say so. Here the label is theirs to write, so the app carries
/// the dates people actually want their friends to know, and no others.
///
/// `day` and `month` are stored apart from any year on purpose. The year is
/// the identifying half of a date of birth and nothing in the product needs
/// it — friends need to know a day is coming, not how old somebody is.
/// Keeping it out means it cannot leak, and ordering by the next occurrence
/// stays simple.
model LifeEvent {
  id         String     @id @default(cuid())
  /// What the person calls it. Free text: "Anniversaire", "Mariage",
  /// "Remise de diplôme" — the app supplies no list and imposes no meaning.
  label      String
  /// 1-31. Validated in the action, not by the database, so a bad value
  /// gives a message in the person's language rather than a 500.
  day        Int
  /// 1-12.
  month      Int
  visibility Visibility @default(FRIENDS)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ownerId])
}


/// A merchant, identified by the domains its product links come from.
/// Somebody telling us a profile or a wish is not acceptable.
///
/// ── Why reporting rather than automatic detection ─────────────────────────
///
/// Photos are uploaded to two places — avatars and wishes — and nothing looks
/// at what is in them. Automatic moderation is either paid (Vision, Rekognition)
/// or a local model that adds seconds to every upload and mistakes a beach
/// holiday for something else. On an app this size that cost buys very little.
///
/// A report is free, exact, and the person looking at the image is a far
/// better judge than a classifier. It stops being enough at a scale this app
/// is nowhere near.
///
/// ── Why the reporter is recorded ──────────────────────────────────────────
///
/// Not to expose them — nothing shows who reported what, ever. It is the only
/// way to refuse a second report of the same thing by the same person, which
/// is what stops the table filling up with one angry evening.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  /// The profile complained about, when it is a profile.
  subjectId  String?
  subject    User?    @relation("Reported", fields: [subjectId], references: [id], onDelete: Cascade)
  /// The wish complained about, when it is a wish.
  giftId     String?
  gift       Gift?    @relation(fields: [giftId], references: [id], onDelete: Cascade)
  reason     String
  /// Cleared once somebody has looked. Kept rather than deleted, so a second
  /// report about the same person is visibly a pattern.
  handledAt  DateTime?
  createdAt  DateTime @default(now())

  /// One report per person per thing: a second is noise, not a signal.
  @@unique([reporterId, subjectId])
  @@unique([reporterId, giftId])
  @@index([handledAt])
}

model Merchant {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  domains String[]

  products Product[]
}

/// The canonical thing a wish points at.
///
/// Free-text url/merchant on Gift cannot support recommendation: two people
/// wanting the same item are only a signal if both wishes resolve to this same
/// row. Everything with a "key" in its name below exists to make that
/// resolution deterministic.
model Product {
  id          String    @id @default(cuid())
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  title       String
  brand       String?
  description String?
  imageUrl    String?
  /// Our own stored copy of imageUrl, made when a preview first reads the
  /// page. imageUrl points at the merchant, which the CSP rightly refuses to
  /// display; this is the same picture served from our origin, shareable by
  /// every gift that links here. Written once — the first preview wins.
  imageStoredPath String?
  sourceUrl   String?
  /// Normalised URL. Computed in TS before every write — Prisma has no
  /// generated columns, so this is not enforced by the database and a write
  /// that skips normalizeUrl() would silently fragment the catalogue.
  urlNorm     String?
  /// SHA-256 of urlNorm. The primary deduplication key.
  urlHash     String?   @unique
  /// Case-folded, de-accented title. Secondary key, scoped per merchant:
  /// the same title at two merchants is two listings, and only a GTIN can
  /// prove they are one product.
  titleKey    String?
  /// EAN/UPC. The only globally unique key, when it exists at all.
  gtin        String?   @unique
  priceCents  Int?
  currency    String    @default("EUR")
  priceBand   Int?
  categoryId  String?
  /// Confidence-weighted and time-decayed; recomputed, never incremented.
  popularity  Int       @default(0)
  status      String    @default("active") // active|stale|dead|merged
  /// Set when this row lost a dedup merge. Readers must follow it, or a
  /// deduplicated pair contributes two rows to the matrix instead of one.
  mergedInto  String?
  /// Which extractor produced this row, so a bad line can be traced back to
  /// its source months later.
  extractedBy String?
  /// Taste vector for content_vector. Unsupported because Prisma has no
  /// `vector` type — every read and write goes through raw SQL in embed.ts.
  embedding   Unsupported("vector(384)")?
  /// WHICH model produced it. Cosine distance between vectors from different
  /// models is not imprecise, it is meaningless — so a comparison must never
  /// cross this field, and a re-embed must clear it.
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gifts Gift[]

  @@unique([merchantId, titleKey])
  @@index([categoryId, priceBand])
  @@index([popularity])
  @@index([status])
}

model Gift {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int?
  currency    String   @default("EUR")
  url         String?
  merchant    String?
  imageUrl    String?
  category    String?
  /// 1 = would be nice, 3 = really wants it.
  priority    Int      @default(2)
  listId      String
  list        GiftList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Nullable on purpose: "Un week-end en Islande" is a real wish with no
  /// product behind it. These rows are invisible to collaborative filtering,
  /// so their proportion is lost signal worth measuring.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservation   Reservation?
  contributions PotContribution[]
  messages      ChatMessage[]
  reports       Report[]

  @@index([listId])
  @@index([productId])
}

/// A gift claimed by one friend, and possibly shared with others.
///
/// This row must never reach the gift's owner. Queries that can run for an
/// owner go through the selectors in src/lib/secrecy.ts, which strip it.
///
/// ── Why "collaborative" lives here and not on Gift ────────────────────────
///
/// It used to be Gift.isPot, set by the list's OWNER when they added the
/// wish. That was the wrong person to ask: whether one friend buys the thing
/// alone or four of them club together is a decision among the friends, taken
/// once they know the price and who else is interested. The owner cannot know
/// that, and — the point of the whole app — must not learn it either.
///
/// So a reservation is the single claim on a gift, and openedToOthers says
/// whether its holder has invited the others in. One row, two states, no way
/// for the two to disagree about who holds what.
model Reservation {
  id         String   @id @default(cuid())
  giftId     String   @unique
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  /// Whoever reserved it first. They stay the initiator once it is opened.
  reserverId String
  reserver   User     @relation(fields: [reserverId], references: [id], onDelete: Cascade)
  /// Set when the holder invites the other friends to chip in.
  openedToOthers Boolean @default(false)
  openedAt       DateTime?
  /// What the pot is aiming at, in cents, as the person who opened it said.
  ///
  /// NOT the wish's price, and never an estimate on its own. A target decides
  /// when contributors are told to stop, so it has to be a figure somebody
  /// took responsibility for. The opener is offered the price we read off the
  /// shop and confirms or corrects it — they have the link in front of them,
  /// which nobody else does.
  ///
  /// Null is a pot with no goal: contributions still add up, there is simply
  /// no bar and no "complete". That is what happens when no price could be
  /// read and the opener left the field empty.
  targetCents    Int?
  /// Whoever went and bought the thing, paying for it themselves.
  ///
  /// No money moves through this app: a contribution is a PROMISE, and at the
  /// end one person is out of pocket for the whole amount. They are the only
  /// one with something at stake, and until now they were the one person who
  /// could not see who owed them what.
  ///
  /// Declaring the purchase is what opens that up — and only to them. Before
  /// it, the pot stays a count and a total for everybody, so nobody is
  /// choosing an amount that will be read next to their name.
  purchasedById  String?
  purchasedBy    User?     @relation("PotBuyer", fields: [purchasedById], references: [id], onDelete: SetNull)
  purchasedAt    DateTime?
  note       String?
  createdAt  DateTime @default(now())

  @@index([reserverId])
  /// Declared in the add_pot_purchase migration but never in this schema, so
  /// every subsequent `migrate dev` proposed dropping it. Written down here
  /// so the schema matches the database rather than silently undoing it.
  @@index([purchasedById])
}

/// Money a friend put toward a collaborative gift. Same secrecy rule.
model PotContribution {
  id            String   @id @default(cuid())
  giftId        String
  gift          Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   User     @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  amountCents   Int
  createdAt     DateTime @default(now())

  @@index([giftId])
  @@index([contributorId])
}

/// What someone did, and how much it counts as evidence of taste.
///
/// This is the recommender's training set, the analytics log, and the trace
/// that explains a recommendation months after it was made.
model GiftEvent {
  id          BigInt    @id @default(autoincrement())
  /// Always from the session, never from the caller.
  actorId     String
  kind        EventKind
  recipientId String?
  productId   String?
  giftId      String?
  categoryId  String?
  /// Denormalised on purpose: a price is a fact about an INSTANT. Joining
  /// Product later would read today's price and rewrite history at every sale.
  priceCents  Int?
  /// Resolved server-side from the kind. A client-supplied weight would let
  /// anyone declare their own click worth ten purchases.
  weight      Float
  sessionId   String?
  source      String?
  occurredAt  DateTime  @default(now())

  @@index([actorId, productId])
  @@index([productId, kind, occurredAt])
  @@index([occurredAt])
  /// Deliberately NOT a unique constraint across all kinds. Once-per-session
  /// is right for views, and wrong for everything else: someone really can
  /// reserve, release and reserve the same product again, and a unique index
  /// would silently swallow the second one. The view cap is a partial unique
  /// index over the browsing kinds only, added in the migration by hand
  /// because Prisma cannot express a WHERE clause on an index.
}

enum EventKind {
  purchase
  reserve
  contribute
  add_wish
  like_wish
  click_out
  view_wish
  view_product
  unreserve
  dismiss_reco
}

/// One line of a generated recommendation list.
///
/// Every row records the strategy that produced it. Without that the CTR per
/// tier is unmeasurable and "why is this here?" has no answer — which is also
/// what makes it possible to DELETE a tier that does not earn its keep.
model Recommendation {
  id       BigInt @id @default(autoincrement())
  viewerId String
  /// Who the gift is for. Null when browsing without a person in mind.
  recipientId String?
  productId   String
  score       Float
  /// cf_item | content_vector | content_facet | popularity
  strategy    String
  /// Explainability: "parce que tu as offert la Chemex".
  becauseProductId String?
  rank             Int
  batchId          String
  generatedAt      DateTime @default(now())

  @@index([viewerId, recipientId, batchId])
  @@index([batchId])
  @@index([strategy])
}

/// Precomputed item-item similarity. Refreshed nightly, never on the fly:
/// the serving path must be one indexed select.
///
/// Not a Prisma-managed relation on either side — both columns are Product
/// ids, and modelling it as two relations would tempt a join that fans out.
model ItemSimilarity {
  productId  String
  neighborId String
  /// cosine × support/(support + SHRINKAGE). See buildItemSimilarity.
  score      Float
  /// How many distinct givers bought/reserved both. The reason the score is
  /// trustworthy at all.
  support    Int
  computedAt DateTime @default(now())

  @@id([productId, neighborId])
  @@index([productId, score])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// Rendered message. Never contains reserver identity for an owner.
  body      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  /// The notifications page filters on userId and sorts by createdAt; the
  /// index above cannot serve that sort, so Postgres was sorting in memory.
  @@index([userId, createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_LIST
  NEW_GIFTS
  EVENT_SOON
  POT_PROGRESS
  CHAT_MESSAGE
}

/// Secret chat between friends about one gift.
///
/// The gift's owner is never a participant and must never read these rows,
/// which is the point: it is where friends coordinate the surprise.
model ChatMessage {
  id        String   @id @default(cuid())
  giftId    String
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([giftId, createdAt])
}

/// One recorded attempt at something that must not be brute-forced.
///
/// Kept in Postgres rather than in Redis on purpose: the database is already
/// there, and adding a second datastore for this would mean a second account,
/// a second set of credentials and a second thing that can be down while the
/// app is up. The write is one indexed insert on a path that already does
/// several queries.
///
/// `key` is what is being limited (an e-mail, an IP), prefixed by the action,
/// so two different limits never share a bucket.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A shareable link that turns into a friendship.
///
/// ── Why this exists ────────────────────────────────────────────────────────
///
/// Kado is worthless alone: a reservation needs somebody to hide it from, and
/// the whole product is what friends do behind your back. But joining took
/// five steps — get the URL by some other means, sign up, search for a name,
/// send a request, wait for it to be accepted. Most people stop somewhere in
/// the middle, and the app stays empty.
///
/// One link collapses that to: click, sign up, you are friends.
///
/// ── Why it is reusable and long-lived ──────────────────────────────────────
///
/// A single-use token would mean generating one per person, which is the
/// awkwardness this removes: the point is to paste ONE link into a family
/// group chat. So a code is a standing invitation to become friends with its
/// owner, and it can be revoked when they are done with it.
model Invite {
  id        String    @id @default(cuid())
  /// The URL-safe code. Random, not derived from the owner: a guessable code
  /// would let anyone befriend anyone by enumeration.
  code      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Set when the owner turns it off. Kept rather than deleted so a stale
  /// link says "this invitation is closed" instead of "not found", which is
  /// what somebody arriving late needs to be told.
  revokedAt DateTime?
  /// How many friendships it has produced. Displayed to the owner, and the
  /// only reason to keep a count at all.
  uses      Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

/// A GIF somebody put on their profile.
///
/// ── Why slots rather than free positioning ─────────────────────────────────
///
/// "Anywhere they like" means a layout editor: drag, drop, resize, touch
/// targets, and a saved geometry that has to survive every screen width. It
/// also means a profile can be made unreadable, and this page exists to help
/// a friend choose a present — decoration must not get in the way of that.
///
/// A fixed set of slots keeps the expressiveness that matters (it is YOUR
/// page, and it looks like you) while the layout stays something we control.
///
/// ── Why the GIF is copied rather than referenced ───────────────────────────
///
/// Only the fields we need are stored, from a source we allowlist. A raw URL
/// from anywhere would make every visit to this profile a request to a server
/// its owner chose — which is a visitor tracker, on a page whose whole point
/// is that people cannot see what others are doing.
model ProfileDecoration {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which place on the page. One decoration per slot, per person.
  slot     String
  /// The animated file, on the provider's CDN.
  gifUrl   String
  /// A still frame, shown when the visitor asked for reduced motion.
  stillUrl String
  width    Int
  height   Int
  /// For the alt text: a GIF with no description is invisible to a screen
  /// reader, and this one is decorative but not meaningless.
  title    String?
  /// Required by the provider's terms, and honest besides: the image is not
  /// ours and the person who put it there did not make it.
  provider String @default("giphy")

  createdAt DateTime @default(now())

  @@unique([userId, slot])
  @@index([userId])
}
