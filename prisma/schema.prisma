generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  /// The pooled connection, used by the running app. On Neon this is the
  /// `-pooler` host; every serverless instance goes through PgBouncer rather
  /// than opening its own connection to Postgres.
  url        = env("DATABASE_URL")
  /// The direct connection, used by migrations only.
  ///
  /// DDL and advisory locks need session state that PgBouncer in transaction
  /// mode does not carry, so `prisma migrate deploy` must bypass the pooler.
  /// Required: Prisma has no implicit fallback. Locally and in CI it is set to
  /// the same URL as above, since a local Postgres has no pooler in front.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  bio           String?
  birthday      DateTime?
  /// An uploaded photo. Absent, the avatar falls back to the person's
  /// initials on a tint derived from their name — see avatarTint() in
  /// format.ts. There is no stored colour: it was removed once nothing
  /// rendered it.
  avatarUrl     String?
  theme         Theme     @default(SYSTEM)
  profilePublic Boolean   @default(false)
  currency      String    @default("EUR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  lists            GiftList[]
  interests        Interest[]
  reservations     Reservation[]
  contributions    PotContribution[]
  sentRequests     Friendship[]      @relation("Requester")
  receivedRequests Friendship[]      @relation("Addressee")
  notifications    Notification[]
  messages         ChatMessage[]
  invites          Invite[]

  @@index([email])
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Interest {
  id     String @id @default(cuid())
  label  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
}

model GiftList {
  id         String     @id @default(cuid())
  name       String
  occasion   String?
  visibility Visibility @default(FRIENDS)
  isDefault  Boolean    @default(false)
  allowPots  Boolean    @default(true)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  gifts Gift[]

  @@index([ownerId])
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

/// A merchant, identified by the domains its product links come from.
model Merchant {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  domains String[]

  products Product[]
}

/// The canonical thing a wish points at.
///
/// Free-text url/merchant on Gift cannot support recommendation: two people
/// wanting the same item are only a signal if both wishes resolve to this same
/// row. Everything with a "key" in its name below exists to make that
/// resolution deterministic.
model Product {
  id          String    @id @default(cuid())
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  title       String
  brand       String?
  description String?
  imageUrl    String?
  sourceUrl   String?
  /// Normalised URL. Computed in TS before every write — Prisma has no
  /// generated columns, so this is not enforced by the database and a write
  /// that skips normalizeUrl() would silently fragment the catalogue.
  urlNorm     String?
  /// SHA-256 of urlNorm. The primary deduplication key.
  urlHash     String?   @unique
  /// Case-folded, de-accented title. Secondary key, scoped per merchant:
  /// the same title at two merchants is two listings, and only a GTIN can
  /// prove they are one product.
  titleKey    String?
  /// EAN/UPC. The only globally unique key, when it exists at all.
  gtin        String?   @unique
  priceCents  Int?
  currency    String    @default("EUR")
  priceBand   Int?
  categoryId  String?
  /// Confidence-weighted and time-decayed; recomputed, never incremented.
  popularity  Int       @default(0)
  status      String    @default("active") // active|stale|dead|merged
  /// Set when this row lost a dedup merge. Readers must follow it, or a
  /// deduplicated pair contributes two rows to the matrix instead of one.
  mergedInto  String?
  /// Which extractor produced this row, so a bad line can be traced back to
  /// its source months later.
  extractedBy String?
  /// Taste vector for content_vector. Unsupported because Prisma has no
  /// `vector` type — every read and write goes through raw SQL in embed.ts.
  embedding   Unsupported("vector(384)")?
  /// WHICH model produced it. Cosine distance between vectors from different
  /// models is not imprecise, it is meaningless — so a comparison must never
  /// cross this field, and a re-embed must clear it.
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gifts Gift[]

  @@unique([merchantId, titleKey])
  @@index([categoryId, priceBand])
  @@index([popularity])
  @@index([status])
}

model Gift {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int?
  currency    String   @default("EUR")
  url         String?
  merchant    String?
  imageUrl    String?
  category    String?
  /// 1 = would be nice, 3 = really wants it.
  priority    Int      @default(2)
  listId      String
  list        GiftList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Nullable on purpose: "Un week-end en Islande" is a real wish with no
  /// product behind it. These rows are invisible to collaborative filtering,
  /// so their proportion is lost signal worth measuring.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservation   Reservation?
  contributions PotContribution[]
  messages      ChatMessage[]

  @@index([listId])
  @@index([productId])
}

/// A gift claimed by one friend, and possibly shared with others.
///
/// This row must never reach the gift's owner. Queries that can run for an
/// owner go through the selectors in src/lib/secrecy.ts, which strip it.
///
/// ── Why "collaborative" lives here and not on Gift ────────────────────────
///
/// It used to be Gift.isPot, set by the list's OWNER when they added the
/// wish. That was the wrong person to ask: whether one friend buys the thing
/// alone or four of them club together is a decision among the friends, taken
/// once they know the price and who else is interested. The owner cannot know
/// that, and — the point of the whole app — must not learn it either.
///
/// So a reservation is the single claim on a gift, and openedToOthers says
/// whether its holder has invited the others in. One row, two states, no way
/// for the two to disagree about who holds what.
model Reservation {
  id         String   @id @default(cuid())
  giftId     String   @unique
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  /// Whoever reserved it first. They stay the initiator once it is opened.
  reserverId String
  reserver   User     @relation(fields: [reserverId], references: [id], onDelete: Cascade)
  /// Set when the holder invites the other friends to chip in.
  openedToOthers Boolean @default(false)
  openedAt       DateTime?
  note       String?
  createdAt  DateTime @default(now())

  @@index([reserverId])
}

/// Money a friend put toward a collaborative gift. Same secrecy rule.
model PotContribution {
  id            String   @id @default(cuid())
  giftId        String
  gift          Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   User     @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  amountCents   Int
  createdAt     DateTime @default(now())

  @@index([giftId])
  @@index([contributorId])
}

/// What someone did, and how much it counts as evidence of taste.
///
/// This is the recommender's training set, the analytics log, and the trace
/// that explains a recommendation months after it was made.
model GiftEvent {
  id          BigInt    @id @default(autoincrement())
  /// Always from the session, never from the caller.
  actorId     String
  kind        EventKind
  recipientId String?
  productId   String?
  giftId      String?
  categoryId  String?
  /// Denormalised on purpose: a price is a fact about an INSTANT. Joining
  /// Product later would read today's price and rewrite history at every sale.
  priceCents  Int?
  /// Resolved server-side from the kind. A client-supplied weight would let
  /// anyone declare their own click worth ten purchases.
  weight      Float
  sessionId   String?
  source      String?
  occurredAt  DateTime  @default(now())

  @@index([actorId, productId])
  @@index([productId, kind, occurredAt])
  @@index([occurredAt])
  /// Deliberately NOT a unique constraint across all kinds. Once-per-session
  /// is right for views, and wrong for everything else: someone really can
  /// reserve, release and reserve the same product again, and a unique index
  /// would silently swallow the second one. The view cap is a partial unique
  /// index over the browsing kinds only, added in the migration by hand
  /// because Prisma cannot express a WHERE clause on an index.
}

enum EventKind {
  purchase
  reserve
  contribute
  add_wish
  like_wish
  click_out
  view_wish
  view_product
  unreserve
  dismiss_reco
}

/// One line of a generated recommendation list.
///
/// Every row records the strategy that produced it. Without that the CTR per
/// tier is unmeasurable and "why is this here?" has no answer — which is also
/// what makes it possible to DELETE a tier that does not earn its keep.
model Recommendation {
  id       BigInt @id @default(autoincrement())
  viewerId String
  /// Who the gift is for. Null when browsing without a person in mind.
  recipientId String?
  productId   String
  score       Float
  /// cf_item | content_vector | content_facet | popularity
  strategy    String
  /// Explainability: "parce que tu as offert la Chemex".
  becauseProductId String?
  rank             Int
  batchId          String
  generatedAt      DateTime @default(now())

  @@index([viewerId, recipientId, batchId])
  @@index([batchId])
  @@index([strategy])
}

/// Precomputed item-item similarity. Refreshed nightly, never on the fly:
/// the serving path must be one indexed select.
///
/// Not a Prisma-managed relation on either side — both columns are Product
/// ids, and modelling it as two relations would tempt a join that fans out.
model ItemSimilarity {
  productId  String
  neighborId String
  /// cosine × support/(support + SHRINKAGE). See buildItemSimilarity.
  score      Float
  /// How many distinct givers bought/reserved both. The reason the score is
  /// trustworthy at all.
  support    Int
  computedAt DateTime @default(now())

  @@id([productId, neighborId])
  @@index([productId, score])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// Rendered message. Never contains reserver identity for an owner.
  body      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_LIST
  NEW_GIFTS
  BIRTHDAY_SOON
  POT_PROGRESS
  CHAT_MESSAGE
}

/// Secret chat between friends about one gift.
///
/// The gift's owner is never a participant and must never read these rows,
/// which is the point: it is where friends coordinate the surprise.
model ChatMessage {
  id        String   @id @default(cuid())
  giftId    String
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([giftId, createdAt])
}

/// One recorded attempt at something that must not be brute-forced.
///
/// Kept in Postgres rather than in Redis on purpose: the database is already
/// there, and adding a second datastore for this would mean a second account,
/// a second set of credentials and a second thing that can be down while the
/// app is up. The write is one indexed insert on a path that already does
/// several queries.
///
/// `key` is what is being limited (an e-mail, an IP), prefixed by the action,
/// so two different limits never share a bucket.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A shareable link that turns into a friendship.
///
/// ── Why this exists ────────────────────────────────────────────────────────
///
/// Kado is worthless alone: a reservation needs somebody to hide it from, and
/// the whole product is what friends do behind your back. But joining took
/// five steps — get the URL by some other means, sign up, search for a name,
/// send a request, wait for it to be accepted. Most people stop somewhere in
/// the middle, and the app stays empty.
///
/// One link collapses that to: click, sign up, you are friends.
///
/// ── Why it is reusable and long-lived ──────────────────────────────────────
///
/// A single-use token would mean generating one per person, which is the
/// awkwardness this removes: the point is to paste ONE link into a family
/// group chat. So a code is a standing invitation to become friends with its
/// owner, and it can be revoked when they are done with it.
model Invite {
  id        String    @id @default(cuid())
  /// The URL-safe code. Random, not derived from the owner: a guessable code
  /// would let anyone befriend anyone by enumeration.
  code      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Set when the owner turns it off. Kept rather than deleted so a stale
  /// link says "this invitation is closed" instead of "not found", which is
  /// what somebody arriving late needs to be told.
  revokedAt DateTime?
  /// How many friendships it has produced. Displayed to the owner, and the
  /// only reason to keep a count at all.
  uses      Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([ownerId])
}
